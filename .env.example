# 数据库驱动：sqlite | postgres | mysql
DB_DRIVER=sqlite

# SQLite 默认路径（相对项目根目录）
DATABASE_URL=sqlite:///./data/intern.db

# PostgreSQL 示例
# DB_DRIVER=postgres
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/intern

# MySQL 示例
# DB_DRIVER=mysql
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/intern

# API
APP_NAME=intern-platform
APP_ENV=development
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# OAuth 回调用（须与各平台 OAuth App 里登记的地址一致）
FRONTEND_BASE=http://127.0.0.1:5173
PUBLIC_API_BASE=http://127.0.0.1:8000
# 未配置 Client 时是否启用本站「同意授权」模拟页（开发默认开）
OAUTH_DEV_MOCK=true

# —— 真实 OAuth：在对应平台「开发者设置」免费创建 OAuth App，无需特殊审批 ——
# GitHub: https://github.com/settings/developers
#   Authorization callback URL = {PUBLIC_API_BASE}/api/v1/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Gitee: https://gitee.com/oauth/applications
#   回调地址 = {PUBLIC_API_BASE}/api/v1/auth/oauth/gitee/callback
# GITEE_CLIENT_ID=
# GITEE_CLIENT_SECRET=

# SMTP（可选；不配则拒绝邮件写入 data/mail/ 便于本地演示）
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com SMTP_PORT=587
# SMTP_USER=你的QQ号@qq.com SMTP_PASSWORD=授权码（非登录密码） SMTP_FROM=同 USER
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
