# Copy to .env before: docker compose up -d --build

APP_NAME=intern-platform
APP_ENV=production
API_PREFIX=/api/v1
SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DB_DRIVER=sqlite
DATABASE_URL=sqlite:////app/data/intern.db

# Public site URL (after domain/HTTPS is ready, update these)
FRONTEND_BASE=http://120.53.18.32:8080
PUBLIC_API_BASE=http://120.53.18.32:8080
CORS_ORIGINS=http://120.53.18.32:8080,http://127.0.0.1:8080

OAUTH_DEV_MOCK=false
SEED_ON_START=true
WEB_PORT=8080

# Optional OAuth apps (committee can also configure in admin UI)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITEE_CLIENT_ID=
# GITEE_CLIENT_SECRET=
